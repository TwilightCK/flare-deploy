{
  "name": "stake-and-date",
  "version": "1.0.0",
  "description": "Crypto gaming matchmaker on Flare",
  "scripts": {
    "check": "node scripts/check-setup.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy-and-setup.js --network coston2",
    "deploy-only": "hardhat run scripts/deploy.js --network coston2",
